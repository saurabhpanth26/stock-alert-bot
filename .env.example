# Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Where alerts are stored
DATA_FILE=data/alerts.json

# Price check interval in seconds
# CHECK_INTERVAL_SECONDS=1

# true = only group admins can add alerts / edit watchlist
ADMIN_ONLY=false

# Lock the bot to your group(s). Send /id in the group to get its ID (e.g. -1001234567890)
ALLOWED_CHAT_IDS=

MAX_ALERTS_PER_CHAT=100

# Set true while testing on a weekend / after hours
CHECK_OUTSIDE_MARKET_HOURS=false

# NSE trading holidays (YYYY-MM-DD, comma separated) – copy from the NSE holiday calendar
NSE_HOLIDAYS=

# Post index + watchlist summary at 15:40 IST on trading days
DAILY_SUMMARY=true

# After an alert fires, it repeats every N seconds until someone taps Acknowledge / sends /ack
REMIND_INTERVAL_SECONDS=30

# Max reminders per alert (0 = unlimited, until acknowledged)
MAX_REMINDERS=10
